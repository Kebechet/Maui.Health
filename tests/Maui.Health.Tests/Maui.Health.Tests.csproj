<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
		<PackageReference Include="xunit" Version="2.*" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Types.Health\Types.Health.csproj" />
	</ItemGroup>

	<!-- Maui.Health itself targets MAUI platform TFMs, so code of it under test is linked as source. -->
	<ItemGroup>
		<!-- Android-only folder, but these two files touch no Android API: the refusal is recognised from message text alone. -->
		<Compile Include="..\..\src\Maui.Health\Platforms\Android\Constants.cs" Link="Android\Constants.cs" />
		<Compile Include="..\..\src\Maui.Health\Platforms\Android\Extensions\ExceptionExtensions.cs" Link="Android\ExceptionExtensions.cs" />
		<!-- How granted Health Connect permission strings become statuses and a request result; no Android API. -->
		<Compile Include="..\..\src\Maui.Health\Platforms\Android\Helpers\HealthConnectPermissions.cs" Link="Android\HealthConnectPermissions.cs" />
		<Compile Include="..\..\src\Maui.Health\Platforms\Android\Extensions\HealthPermissionExtensions.cs" Link="Android\HealthPermissionExtensions.cs" />
		<Compile Include="..\..\src\Maui.Health\Platforms\Android\Extensions\StringExtensions.cs" Link="Android\StringExtensions.cs" />
	</ItemGroup>

</Project>
